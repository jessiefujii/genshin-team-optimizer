{
  "name": "genshin-team-optimizer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --exclude \"**/*.perf.test.ts\" --exclude \"**/*.compare.test.ts\" --exclude \"**/*.write.test.ts\"",
    "bench": "vitest run src/lib/scoring/search.perf.test.ts",
    "compare": "vitest run src/lib/scoring/known-teams.compare.test.ts --silent=false",
    "meta": "vitest run src/lib/scoring/meta-teams.compare.test.ts src/lib/scoring/roster.compare.test.ts --silent=false",
    "roster": "vitest run src/lib/scoring/roster.compare.test.ts --silent=false",
    "reference": "vitest run src/lib/scoring/team-reference.write.test.ts --silent=false",
    "kit": "node scripts/extract-kit.mjs",
    "roles": "node scripts/fetch-roles.mjs"
  },
  "dependencies": {
    "genshin-db": "^5.2.14",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
